{{!
    @template mod_peerfeedback/teacher_feedback

    The teacher's feedback to a student about the feedback the student wrote.

    Example context (json):
    {"overall": "Good start", "overallhtml": "<p>Good start</p>", "hasitems": true,
     "items": [{"id": 3, "title": "Your feedback about Can Yılmaz", "comment": "<p>Add examples</p>", "grade": "80 / 100",
        "answers": [{"question": "Communication", "value": "4 / 5"}]}]}
}}
<section class="pf-teacherfeedback" id="pf-teacherfeedback">
    <h3 class="h5 mt-4 mb-1">{{#str}}teacherfeedback, mod_peerfeedback{{/str}}</h3>
    <p class="text-muted small mb-2">{{#str}}teacherfeedbackintro, mod_peerfeedback{{/str}}</p>
    {{#overall}}
    <div class="pf-tf-overall card card-body mb-2">
        <div class="fw-semibold mb-1">{{#str}}overallcomment, mod_peerfeedback{{/str}}</div>
        <div class="pf-tf-text">{{{overallhtml}}}</div>
    </div>
    {{/overall}}
    {{#hasitems}}
    <ul class="pf-tf-list list-unstyled mb-0">
        {{#items}}
        <li class="pf-tf-item card card-body mb-2">
            <div class="pf-tf-head">
                <span class="fw-semibold">{{title}}</span>
                {{#grade}}<span class="badge pf-pill-ok">{{#str}}teachergrade, mod_peerfeedback{{/str}}: {{grade}}</span>{{/grade}}
            </div>
            {{#comment}}<div class="pf-tf-text">{{{comment}}}</div>{{/comment}}
            <details class="pf-tf-answers">
                <summary>{{#str}}youranswers, mod_peerfeedback{{/str}}</summary>
                <dl class="mb-0 mt-1">
                    {{#answers}}<dt class="fw-normal text-muted small">{{question}}</dt><dd class="pf-pre">{{value}}</dd>{{/answers}}
                </dl>
            </details>
        </li>
        {{/items}}
    </ul>
    {{/hasitems}}
</section>
