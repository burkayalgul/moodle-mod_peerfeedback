{{!
    @template mod_peerfeedback/answer

    Student answering screen: peers as tabs, one person at a time.

    Example context (json):
    {"cmid": 1, "sesskey": "x", "actionurl": "#", "haspeers": true, "peerid": 5, "percent": 50,
     "progresstext": "1 of 2 submitted", "peername": "Zeynep Arslan", "initials": "ZA", "position": "2 of 2",
     "status": "Not started", "readonly": false, "backurl": "#",
     "tabs": [{"name": "Can Yılmaz", "url": "#", "active": false, "saved": false, "done": true},
              {"name": "Zeynep Arslan", "url": "#", "active": true, "saved": false, "done": false}],
     "questions": [{"id": 1, "name": "q1", "number": "Q1", "text": "How well did they communicate?", "required": true,
        "israting": true, "options": [{"value": 1}, {"value": 2}, {"value": 3, "checked": true}], "minlabel": "Poorly",
        "maxlabel": "Very well"}]}
}}
<div class="pf-answer">
{{#notice}}<div class="alert alert-info">{{notice}}</div>{{/notice}}
{{#haspeers}}
    <nav class="pf-tabs" aria-label="{{#str}}peers, mod_peerfeedback{{/str}}">
        {{#tabs}}
        <a href="{{url}}" class="pf-tab{{#active}} pf-active{{/active}}{{#done}} pf-done{{/done}}{{#saved}} pf-saved{{/saved}}"
            {{#active}}aria-current="page"{{/active}}>{{#done}}<span aria-hidden="true">✓ </span>{{/done}}{{name}}</a>
        {{/tabs}}
    </nav>
    <div class="pf-progress" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"
        aria-label="{{progresstext}}"><span style="width: {{percent}}%"></span></div>
    <p class="pf-progress-text">{{progresstext}}</p>

    <div class="pf-person">
        <div class="pf-avatar" aria-hidden="true">{{initials}}</div>
        <div><div class="pf-person-name">{{peername}}</div>
            <div class="pf-person-meta">{{position}} · {{status}}</div></div>
    </div>

    {{#lockednotice}}<div class="alert alert-secondary">{{lockednotice}}</div>{{/lockednotice}}
    {{#haserrors}}<div class="alert alert-danger" role="alert">{{#str}}fixerrors, mod_peerfeedback{{/str}}</div>{{/haserrors}}

    <form method="post" action="{{actionurl}}" class="pf-form" novalidate>
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="peer" value="{{peerid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#questions}}
        {{#isheading}}<div class="pf-heading"><h4>{{text}}</h4>{{#description}}<div class="pf-q-desc">{{description}}</div>{{/description}}</div>{{/isheading}}
        {{^isheading}}
        <fieldset class="pf-q{{#error}} pf-has-error{{/error}}">
            <legend class="pf-q-title">{{#number}}<span class="pf-qnum">{{number}}</span>{{/number}}
                {{#israting}}{{text}}{{/israting}}{{#isgrid}}{{text}}{{/isgrid}}{{#issinglechoice}}{{text}}{{/issinglechoice}}{{#ismultichoice}}{{text}}{{/ismultichoice}}
                {{#isnumber}}<label for="id_q{{id}}">{{text}}</label>{{/isnumber}}{{#isshorttext}}<label for="id_q{{id}}">{{text}}</label>{{/isshorttext}}{{#islongtext}}<label for="id_q{{id}}">{{text}}</label>{{/islongtext}}
                {{#required}}<span class="pf-req" title="{{#str}}requiredquestion, mod_peerfeedback{{/str}}">*</span>{{/required}}</legend>
            {{#description}}<div class="pf-q-desc">{{description}}</div>{{/description}}

            {{#israting}}
            <div class="pf-rating-wrap"><div class="pf-rating">
                {{#options}}<label class="pf-scale"><input type="radio" name="{{name}}" value="{{value}}" {{#checked}}checked{{/checked}}
                    {{#readonly}}disabled{{/readonly}}><span>{{value}}</span></label>{{/options}}
            </div>
            {{#minlabel}}<div class="pf-scale-labels"><span>{{minlabel}}</span><span>{{maxlabel}}</span></div>{{/minlabel}}
            {{^minlabel}}{{#maxlabel}}<div class="pf-scale-labels"><span></span><span>{{maxlabel}}</span></div>{{/maxlabel}}{{/minlabel}}
            </div>
            {{/israting}}

            {{#isgrid}}
            <div class="table-responsive"><table class="table table-sm pf-grid">
                <thead><tr><th scope="col"></th>{{#scale}}<th scope="col" class="text-center">{{.}}</th>{{/scale}}</tr></thead>
                <tbody>{{#criteria}}<tr><th scope="row">{{label}}</th>
                    {{#options}}<td class="text-center"><input type="radio" name="q{{id}}[{{index}}]" value="{{value}}"
                        aria-label="{{label}} {{value}}" {{#checked}}checked{{/checked}} {{#readonly}}disabled{{/readonly}}></td>{{/options}}
                </tr>{{/criteria}}</tbody>
            </table></div>
            {{/isgrid}}

            {{#issinglechoice}}{{#options}}
            <div class="form-check"><input class="form-check-input" type="radio" name="q{{id}}" value="{{index}}" id="id_q{{id}}_{{index}}"
                {{#checked}}checked{{/checked}} {{#readonly}}disabled{{/readonly}}>
                <label class="form-check-label" for="id_q{{id}}_{{index}}">{{label}}</label></div>
            {{/options}}{{/issinglechoice}}

            {{#ismultichoice}}{{#options}}
            <div class="form-check"><input class="form-check-input" type="checkbox" name="q{{id}}[{{index}}]" value="1" id="id_q{{id}}_{{index}}"
                {{#checked}}checked{{/checked}} {{#readonly}}disabled{{/readonly}}>
                <label class="form-check-label" for="id_q{{id}}_{{index}}">{{label}}</label></div>
            {{/options}}{{/ismultichoice}}

            {{#isnumber}}<input type="number" step="any" class="form-control pf-number" id="id_q{{id}}" name="{{name}}" value="{{value}}"
                {{#min}}min="{{min}}"{{/min}} {{#max}}max="{{max}}"{{/max}} {{#readonly}}disabled{{/readonly}}>{{/isnumber}}
            {{#isshorttext}}<input type="text" maxlength="255" class="form-control" id="id_q{{id}}" name="{{name}}" value="{{value}}"
                {{#readonly}}disabled{{/readonly}}>{{/isshorttext}}
            {{#islongtext}}<textarea class="form-control" rows="4" id="id_q{{id}}" name="{{name}}"
                {{#readonly}}disabled{{/readonly}}>{{value}}</textarea>{{/islongtext}}

            {{#error}}<div class="pf-error">{{error}}</div>{{/error}}
        </fieldset>
        {{/isheading}}
        {{/questions}}

        {{#review}}
        <div class="pf-review card card-body">
            <h4 class="h6">{{#str}}teacherreview, mod_peerfeedback{{/str}}</h4>
            {{#grade}}<div>{{#str}}teachergrade, mod_peerfeedback{{/str}}: <strong>{{grade}}</strong></div>{{/grade}}
            {{#comment}}<div>{{#str}}teachercomment, mod_peerfeedback{{/str}}: {{{comment}}}</div>{{/comment}}
        </div>
        {{/review}}

        <div class="pf-actions">
            {{#backurl}}<a href="{{backurl}}" class="btn btn-outline-secondary">← {{#str}}back, mod_peerfeedback{{/str}}</a>{{/backurl}}
            {{^backurl}}<span></span>{{/backurl}}
            {{^readonly}}<div class="d-flex gap-2">
                <button type="submit" name="savebtn" value="1" class="btn btn-outline-primary">{{#str}}savenext, mod_peerfeedback{{/str}}</button>
                <button type="submit" name="submitbtn" value="1" class="btn btn-primary">{{#str}}submit, mod_peerfeedback{{/str}}</button>
            </div>{{/readonly}}
        </div>
    </form>
{{/haspeers}}
</div>
