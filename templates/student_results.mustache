{{!
    @template mod_peerfeedback/student_results

    Feedback a student is allowed to see.

    Example context (json):
    {"heading": "Feedback about you", "hasitems": true, "items": [{"title": "Feedback 1",
     "answers": [{"question": "Communication", "value": "4 / 5"}], "grade": null, "teachercomment": null}]}
}}
<section class="pf-results">
    <h3 class="h5 mt-4">{{heading}}</h3>
    {{^hasitems}}<p class="text-muted">{{#str}}nofeedbackyet, mod_peerfeedback{{/str}}</p>{{/hasitems}}
    {{#items}}
    <div class="pf-result card card-body mb-2">
        <div class="fw-semibold mb-1">{{title}}</div>
        <dl class="mb-0">
            {{#answers}}<dt class="fw-normal text-muted small">{{question}}</dt><dd class="pf-pre">{{value}}</dd>{{/answers}}
        </dl>
        {{#grade}}<div class="mt-1">{{#str}}teachergrade, mod_peerfeedback{{/str}}: <strong>{{grade}}</strong></div>{{/grade}}
        {{#teachercomment}}<div>{{#str}}teachercomment, mod_peerfeedback{{/str}}: {{teachercomment}}</div>{{/teachercomment}}
    </div>
    {{/items}}
</section>
