{{!
    @template mod_peerfeedback/overview

    Teacher landing page.

    Example context (json):
    {"students": 7, "unassigned": 0, "groups": 3, "questions": 8, "submitted": 4, "reviewed": 1,
     "questionsurl": "#", "groupsurl": "#", "reviewurl": "#"}
}}
<div class="pf-overview row g-3">
    <div class="col-sm-6 col-lg-3"><a class="pf-stat card card-body" href="{{questionsurl}}">
        <span class="pf-stat-n">{{questions}}</span><span>{{#str}}overviewquestions, mod_peerfeedback{{/str}}</span></a></div>
    <div class="col-sm-6 col-lg-3"><a class="pf-stat card card-body" href="{{groupsurl}}">
        <span class="pf-stat-n">{{groups}}</span><span>{{#str}}overviewgroups, mod_peerfeedback{{/str}}</span>
        {{#unassigned}}<small class="text-warning-emphasis">{{#str}}overviewunassigned, mod_peerfeedback, {{unassigned}}{{/str}}</small>{{/unassigned}}</a></div>
    <div class="col-sm-6 col-lg-3"><a class="pf-stat card card-body" href="{{reviewurl}}">
        <span class="pf-stat-n">{{submitted}}</span><span>{{#str}}overviewsubmitted, mod_peerfeedback{{/str}}</span></a></div>
    <div class="col-sm-6 col-lg-3"><a class="pf-stat card card-body" href="{{reviewurl}}">
        <span class="pf-stat-n">{{reviewed}}</span><span>{{#str}}overviewreviewed, mod_peerfeedback{{/str}}</span></a></div>
</div>
